# Model & server Ollama
MODEL=qwen3.5:9b
NUM_CTX=8192
# Lokal tanpa docker: http://localhost:11434 | docker compose: http://ollama:11434 | Ollama Cloud: https://ollama.com
OLLAMA_HOST=http://localhost:11434
# Isi hanya kalau pakai Ollama Cloud
OLLAMA_API_KEY=

# Lindungi endpoint (WAJIB di VPS). Kirim lewat header X-API-Key
API_KEY=

# Folder kerja agent
WORKDIR=./workspace
# Izinkan agent menjalankan shell (sebaiknya hanya di dalam docker)
ALLOW_SHELL=false

# Telegram bot (app/telegram_bot.py)
TELEGRAM_TOKEN=
# Kosongkan dulu: bot akan membalas dengan chat ID kamu
ALLOWED_CHAT_ID=
# Alamat API. Lokal: http://localhost:8000 | docker compose: http://api:8000
API_URL=http://localhost:8000
